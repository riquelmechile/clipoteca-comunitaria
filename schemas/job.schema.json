{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipoteca.example/schemas/job.schema.json",
  "title": "Job",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "status", "language_counts", "provider_counts", "source_errors"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "searching", "fetching", "processing", "publishing", "published", "no_results", "duplicate", "failed", "rate_limited", "unavailable"]},
    "language_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "provider_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "source_errors": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
