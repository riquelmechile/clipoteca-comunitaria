{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Published studio video",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "created_at",
    "script_id",
    "title",
    "aspect",
    "language",
    "media",
    "storage",
    "script",
    "scenes",
    "qa",
    "timings",
    "engine"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^video-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "script_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aspect": {
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ]
    },
    "language": {
      "const": "es"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_s",
        "width",
        "height",
        "fps",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_tag",
        "asset_url"
      ],
      "properties": {
        "release_tag": {
          "type": "string",
          "pattern": "^video-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3,}$"
        },
        "asset_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      }
    },
    "script": {
      "type": "object"
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "clip_id",
          "imported",
          "source_url",
          "start",
          "len"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "clip_id": {
            "type": "string",
            "pattern": "^clip-[0-9]{6}$"
          },
          "imported": {
            "type": "boolean"
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "len": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "checks",
        "wer",
        "sync_mean_ms",
        "sync_p95_ms",
        "lufs",
        "true_peak_dbfs"
      ],
      "properties": {
        "pass": {
          "const": true
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "patternProperties": {
            "^[a-z][a-z_0-9]*$": {
              "const": true
            }
          }
        },
        "wer": {
          "type": "number",
          "minimum": 0
        },
        "sync_mean_ms": {
          "type": "number",
          "minimum": 0
        },
        "sync_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "lufs": {
          "type": "number"
        },
        "true_peak_dbfs": {
          "type": "number"
        }
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clipoteca",
        "hyperframes",
        "gsap_sha256"
      ],
      "properties": {
        "clipoteca": {
          "type": "string",
          "minLength": 1
        },
        "hyperframes": {
          "type": "string",
          "minLength": 1
        },
        "gsap_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
