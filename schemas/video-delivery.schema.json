{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clipoteca video delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "script_id",
    "title",
    "aspect",
    "duration_s",
    "sha256",
    "size_bytes",
    "qa",
    "scenes",
    "clips_indexed",
    "timings"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "script_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aspect": {
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ]
    },
    "duration_s": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "size_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "failed"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "clip_id",
              "origin",
              "source",
              "source_url",
              "status",
              "fallback"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "clip_id": {
                "type": "string",
                "pattern": "^(?:clip-[0-9]{6}|imp-[a-f0-9]{12})$"
              },
              "origin": {
                "enum": [
                  "catalog",
                  "imported"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "status": {
                "const": "ok"
              },
              "fallback": {
                "type": "boolean"
              },
              "degraded_reason": {
                "type": "string",
                "minLength": 1
              },
              "related_terms": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "term",
                    "origin"
                  ],
                  "properties": {
                    "term": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "origin": {
                      "enum": [
                        "script",
                        "wikidata",
                        "commons"
                      ]
                    }
                  }
                }
              },
              "matched_query": {
                "type": "string",
                "minLength": 1
              },
              "found_by_query": {
                "type": "string",
                "minLength": 1
              },
              "related_diagnostic": {
                "$ref": "#/$defs/related_diagnostic"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "reason",
              "tried"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "const": "fail"
              },
              "reason": {
                "type": "string"
              },
              "tried": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "related_terms": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "term",
                    "origin"
                  ],
                  "properties": {
                    "term": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "origin": {
                      "enum": [
                        "script",
                        "wikidata",
                        "commons"
                      ]
                    }
                  }
                }
              },
              "related_diagnostic": {
                "$ref": "#/$defs/related_diagnostic"
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "degraded_reason"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "degraded_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "clips_indexed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^clip-[0-9]{6}$"
      }
    },
    "timings": {
      "type": "object",
      "patternProperties": {
        "^scene\\..+\\.(import|import_retry)\\.commons_consulted$": {
          "type": "boolean"
        }
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qa": {
            "properties": {
              "pass": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "duration_s": {
            "type": "number"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "scenes": {
            "items": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "related_diagnostic": {
      "type": "object",
      "required": [
        "seeds",
        "roots",
        "commons_roots",
        "terms_by_origin",
        "errors",
        "timeouts",
        "providers",
        "elapsed_s",
        "batch_elapsed_s",
        "status"
      ],
      "properties": {
        "seeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "qid",
              "label"
            ],
            "properties": {
              "qid": {
                "type": "string",
                "pattern": "^Q[1-9][0-9]*$"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "commons_roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "terms_by_origin": {
          "type": "object",
          "required": [
            "script",
            "wikidata",
            "commons"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider",
              "seed",
              "error",
              "http_status"
            ],
            "properties": {
              "provider": {
                "enum": [
                  "wikidata",
                  "commons"
                ]
              },
              "seed": {
                "type": "string"
              },
              "error": {
                "type": "string"
              },
              "http_status": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "timeouts": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_s": {
          "type": "number",
          "minimum": 0
        },
        "batch_elapsed_s": {
          "type": "number",
          "minimum": 0
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "no_entity"
          ]
        }
      }
    }
  }
}
