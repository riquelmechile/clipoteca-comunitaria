{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clipoteca video delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "script_id",
    "title",
    "aspect",
    "duration_s",
    "sha256",
    "size_bytes",
    "qa",
    "scenes",
    "clips_indexed",
    "timings"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "script_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aspect": {
      "enum": [
        "9:16",
        "16:9",
        "1:1"
      ]
    },
    "duration_s": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "size_bytes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pass",
        "failed"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "clip_id",
              "origin",
              "source",
              "source_url",
              "status",
              "fallback"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "clip_id": {
                "type": "string",
                "pattern": "^(?:clip-[0-9]{6}|imp-[a-f0-9]{12})$"
              },
              "origin": {
                "enum": [
                  "catalog",
                  "imported"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "status": {
                "const": "ok"
              },
              "fallback": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "reason",
              "tried"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "const": "fail"
              },
              "reason": {
                "type": "string"
              },
              "tried": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    },
    "clips_indexed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^clip-[0-9]{6}$"
      }
    },
    "timings": {
      "type": "object",
      "patternProperties": {
        "^scene\\..+\\.(import|import_retry)\\.commons_consulted$": {
          "type": "boolean"
        }
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "qa": {
            "properties": {
              "pass": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "duration_s": {
            "type": "number"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "scenes": {
            "items": {
              "properties": {
                "status": {
                  "const": "ok"
                }
              }
            }
          }
        }
      }
    }
  ]
}
