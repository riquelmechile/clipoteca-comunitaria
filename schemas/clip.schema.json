{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipoteca.example/schemas/clip.schema.json",
  "title": "Clip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "tags",
    "source",
    "media",
    "storage",
    "status",
    "created_at"
  ],
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "es",
        "en"
      ],
      "properties": {
        "es": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localizedTags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "es",
        "en"
      ],
      "properties": {
        "es": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "if": {"properties": {"status": {"const": "retired"}}},
  "then": {"required": ["retirement"]},
  "else": {"not": {"required": ["retirement"]}},
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^clip-[0-9]{6}$"
    },
    "title": {
      "$ref": "#/$defs/localizedText"
    },
    "description": {
      "$ref": "#/$defs/localizedText"
    },
    "tags": {
      "$ref": "#/$defs/localizedTags"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "provider_id",
        "source_language",
        "source_title",
        "source_url"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "source_language": {
          "type": "string",
          "minLength": 2
        },
        "found_by_query": {"type": "string", "minLength": 1, "maxLength": 200},
        "related_to": {"type": "string", "minLength": 1, "maxLength": 200},
        "commons_category": {"type": "string", "minLength": 1},
        "commons_place_aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_title": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1
        },
        "issue_author": {
          "type": "string",
          "minLength": 1
        },
        "issue_url": {
          "type": "string",
          "format": "uri"
        },
        "source_start": {
          "type": "number",
          "minimum": 0
        },
        "source_end": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds",
        "width",
        "height",
        "fps",
        "aspect_ratio",
        "orientation",
        "codec",
        "container",
        "has_audio",
        "size_bytes",
        "sha256",
        "perceptual_hash"
      ],
      "properties": {
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9",
            "1:1",
            "other"
          ]
        },
        "orientation": {
          "enum": [
            "vertical",
            "horizontal",
            "square",
            "other"
          ]
        },
        "codec": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "has_audio": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "perceptual_hash": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "asset_url",
        "thumbnail_url"
      ],
      "properties": {
        "provider": {
          "const": "github_releases"
        },
        "asset_url": {
          "type": "string",
          "format": "uri"
        },
        "thumbnail_url": {
          "type": "string",
          "format": "uri"
        },
        "storyboard_urls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "status": {
      "enum": ["published", "retired"]
    },
    "retirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "date"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"}
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
